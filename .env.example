# ARS Computers — Environment Variable Reference
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real credentials.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-side only.
#
# External service integrations will be configured in dedicated
# implementation stages. This file documents the variable names only.

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL database and authentication)
# Docs: https://supabase.com/docs/guides/getting-started
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WARNING: service role key is privileged — server-side only, never NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 (image and file storage, S3-compatible)
# Docs: https://developers.cloudflare.com/r2/
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL for the R2 bucket (e.g. via custom domain or R2.dev subdomain)
NEXT_PUBLIC_R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Brevo (transactional email)
# Docs: https://developers.brevo.com/
# ---------------------------------------------------------------------------
# WARNING: API key is privileged — server-side only, never NEXT_PUBLIC_
BREVO_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Canonical site URL — used for absolute URL generation and SEO
NEXT_PUBLIC_SITE_URL=
